# ────────────────────────────────────────────────────────────
# Syrian Military Supply — environment configuration
# Copy to `.env` and fill in values. NEVER commit `.env`.
# ────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB — use your Atlas URI in production:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/syrian-military-supply
MONGODB_URI=mongodb://localhost:27017/syrian-military-supply

# JWT secret for admin auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Cloudinary (product image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=syrian-military-supply

# CORS — comma-separated origins allowed in production (or leave empty for *)
CORS_ORIGIN=

# Seed route guard — set ALLOW_SEED=true once, run it, then disable
ALLOW_SEED=false

# Site
SITE_URL=http://localhost:5000